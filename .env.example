# Copia este archivo a `.env` y ajusta los valores.
# NUNCA commits `.env` — contiene credenciales reales.
# El proyecto falla explícitamente si falta alguna variable requerida.

# --- Requeridas por docker-compose ---
POSTGRES_DB=promociones
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-este-password

# --- Opcionales (con defaults seguros) ---
# Puertos publicados por compose
BACKEND_PORT=3000
FRONTEND_PORT=8080
POSTGRES_PORT=5432

# Orígenes CORS permitidos para el backend (separados por coma)
# CORS_ORIGIN=http://localhost:8080,http://localhost:5173